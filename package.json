{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:seo-assets": "node scripts/generate-seo-assets.mjs",
    "build": "node scripts/generate-seo-assets.mjs && node scripts/generate-brand-icons.mjs && node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/verify-seo.mjs && node scripts/verify-redirects.mjs && node scripts/indexnow.mjs",
    "audit": "node scripts/seo-audit.mjs",
    "spellcheck": "cspell lint \"src/**/*.{mdx,astro,ts,tsx,css}\" \"public/robots.txt\" \"public/_redirects\" --no-progress",
    "typecheck": "astro check",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "chrome-launcher": "^1.2.3",
    "cspell": "^8.17.5",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.2"
  }
}
