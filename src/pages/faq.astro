---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, siteIdentityGraphNodes, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    ...siteIdentityGraphNodes(),
    webPageSchema({
      name: 'FAQ — Borderlands 3 Cheats & Setup',
      description:
        'Answers about Borderlands 3 soft aim, ESP, Cloud DMA, pricing, checkout, and setup at borderlandscheats.com.',
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <header class="section-header space-y-0">
          <p class="section-header__eyebrow">Help center</p>
          <h1 id="faq-page-title" class="section-header__title">Borderlands 3 cheats FAQ</h1>
          <p class="section-header__subtitle">Features, Cloud DMA, pricing, and setup—in one place.</p>
        </header>
      </div>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" sectionHeadingLevel="h2" />
</BaseLayout>
