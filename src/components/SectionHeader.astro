---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  /** Use h2 when the page already has a primary h1 (e.g. FAQ index). */
  headingLevel?: 'h1' | 'h2';
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, headingLevel = 'h1', centered = false, wide = false } = Astro.props;
const TitleTag = headingLevel;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <TitleTag id={titleId} class="section-header__title">{title}</TitleTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
