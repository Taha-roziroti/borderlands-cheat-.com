---
import { t } from '../i18n';
import { toolkitIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';

const s = t.toolkit;
---

<section id="toolkit" class="border-t border-border bg-background py-16 md:py-24" aria-labelledby="toolkit-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="toolkit-title" headingLevel="h2" />

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.items.map((item) => (
          <li class="rounded-2xl border border-border bg-card/70 p-5 shadow-sm transition-colors hover:border-primary/35">
            <div class="flex items-start gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 font-[family-name:var(--font-heading)] text-sm font-bold text-primary">
                {item.num}
              </span>
              <div class="min-w-0 space-y-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{item.label}</p>
                <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-lg font-bold leading-tight text-foreground">
                  <Icon name={toolkitIcons[item.label] ?? 'navFeatures'} size={18} class="text-primary" />
                  {item.title}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">{item.desc}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button as="a" href="/borderlands-3-aimbot/" variant="outline" size="lg" class="rounded-xl">
        Borderlands 3 aimbot
      </Button>
      <Button as="a" href="/borderlands-3-esp/" variant="outline" size="lg" class="rounded-xl">
        Borderlands 3 ESP
      </Button>
      <Button as="a" href="/borderlands-3-pricing/" variant="primary" size="lg" class="rounded-xl">
        View available plans
      </Button>
    </div>
  </div>
</section>
