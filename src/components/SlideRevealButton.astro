---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';

interface Props {
  /** Omit when rendering as a button (e.g. dialog trigger). */
  href?: string;
  /** e.g. sponsored affiliate outbound */
  rel?: string;
  target?: string;
  class?: string;
  ariaLabel?: string;
  icon?: IconName;
  /** Use `button` for modal triggers; default `a` for navigation. */
  as?: 'a' | 'button';
  type?: 'button' | 'submit';
}

const {
  href,
  rel,
  target,
  class: className,
  ariaLabel,
  icon = 'arrowRight',
  as = 'a',
  type = 'button',
  ...rest
} = Astro.props;

---

{
  as === 'button' ? (
    <button
      type={type}
      class:list={['slide-reveal-btn', 'cursor-pointer appearance-none border-0 bg-transparent p-0 font-inherit', className]}
      aria-label={ariaLabel}
      {...rest}
    >
      <span class="slide-reveal-btn__icon" aria-hidden="true">
        <Icon name={icon} size={18} class="slide-reveal-btn__svg" />
      </span>
      <span class="slide-reveal-btn__text">
        <slot />
      </span>
    </button>
  ) : (
    <a
      href={href}
      class:list={['slide-reveal-btn', className]}
      aria-label={ariaLabel}
      rel={rel}
      target={target}
      {...rest}
    >
      <span class="slide-reveal-btn__icon" aria-hidden="true">
        <Icon name={icon} size={18} class="slide-reveal-btn__svg" />
      </span>
      <span class="slide-reveal-btn__text">
        <slot />
      </span>
    </a>
  )
}
